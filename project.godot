; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node",
"class": "AsepriteImportData",
"language": "GDScript",
"path": "res://addons/aseprite_importer/classes/AsepriteImportData.gd"
}, {
"base": "Node",
"class": "AsepriteImporter",
"language": "GDScript",
"path": "res://addons/aseprite_importer/classes/AsepriteImporter.gd"
}, {
"base": "Node",
"class": "EditorTheme",
"language": "GDScript",
"path": "res://addons/aseprite_importer/classes/EditorTheme.gd"
} ]
_global_script_class_icons={
"AsepriteImportData": "",
"AsepriteImporter": "",
"EditorTheme": ""
}

[application]

config/name="Hedgehog Adventure"
run/main_scene="res://Assets/Scenes/Intro.tscn"
config/use_custom_user_dir=true
config/icon="res://icon.png"

[autoload]

MusicController="*res://Assets/Autoloads/MusicController.tscn"
Pause="*res://Assets/Autoloads/Pause.tscn"
SaveSystem="*res://Assets/Autoloads/SaveSystem.tscn"
LevelManager="*res://Assets/Autoloads/LevelManager.tscn"

[display]

window/size/width=640
window/size/height=360
window/size/resizable=false
window/size/fullscreen=true
window/stretch/mode="2d"

[editor_plugins]

enabled=PoolStringArray( "res://addons/aseprite_importer/plugin.cfg", "res://addons/godotoro/plugin.cfg" )

[global]

"języ"=false
"język"=false
editor=false
interface=false
theme=false

[gui]

theme/custom="res://godotTheme/theme.tres"

