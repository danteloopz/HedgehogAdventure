[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Platform"
2d_physics/layer_3="Fallzone"
2d_physics/layer_4="Item"
2d_physics/layer_5="Enemy"
2d_physics/layer_6="Spawnpoint"

[physics]

